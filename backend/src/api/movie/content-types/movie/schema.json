{
  "kind": "collectionType",
  "collectionName": "movies",
  "info": {
    "singularName": "movie",
    "pluralName": "movies",
    "displayName": "Movie"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "releaseDate": {
      "type": "date"
    },
    "movieStatus": {
      "type": "enumeration",
      "enum": [
        "In Development",
        "Pre-Production",
        "Production",
        "Post-Production",
        "Released"
      ]
    },
    "trailerUrl": {
      "type": "string"
    },
    "duration": {
      "type": "string"
    },
    "rating": {
      "type": "string"
    },
    "logline": {
      "type": "text"
    },
    "description": {
      "type": "text"
    },
    "director": {
      "type": "string"
    },
    "writers": {
      "type": "string"
    },
    "producers": {
      "type": "string"
    },
    "poster": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "posterLabel": {
      "type": "string"
    },
    "genres": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::genre.genre",
      "mappedBy": "movies"
    },
    "actors": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::actor.actor",
      "mappedBy": "movies"
    }
  }
}
