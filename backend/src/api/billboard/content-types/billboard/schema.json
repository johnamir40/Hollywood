{
  "kind": "collectionType",
  "collectionName": "billboards",
  "info": {
    "singularName": "billboard",
    "pluralName": "billboards",
    "displayName": "Billboard"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "location": {
      "type": "string"
    },
    "direction": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "images": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos"
      ]
    },
    "zone": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::zone.zone",
      "required": true,
      "inversedBy": "billboards"
    },
    "availabilityStatus": {
      "type": "enumeration",
      "required": true,
      "default": "Available",
      "enum": [
        "Available",
        "Reserved",
        "On Hold"
      ]
    },
    "availableFrom": {
      "type": "date"
    },
    "googleMapsUrl": {
      "type": "string"
    },
    "cardNumber": {
      "type": "integer",
      "required": true,
      "unique": true
    }
  }
}
