{
  "kind": "collectionType",
  "collectionName": "zones",
  "info": {
    "singularName": "zone",
    "pluralName": "zones",
    "displayName": "Zone"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "shortName": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "billboards": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::billboard.billboard",
      "mappedBy": "zone"
    }
  }
}
